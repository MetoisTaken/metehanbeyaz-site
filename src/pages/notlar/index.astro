---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('notlar', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: '2-digit' });
---

<BaseLayout title="Notlar | Metehan Beyaz" description="Notlar ve yazılar.">
  <div class="page-head">
    <div>
      <h1>Notlar</h1>
      <p class="lead">Kişisel notlar ve yazılar.</p>
    </div>
  </div>

  <div class="stack">
    {posts.length > 0 ? (
      posts.map((post) => (
        <a href={`/notlar/${post.id}`} class="post-item">
          <div>
            <div class="post-title">{post.data.title}</div>
            <div class="post-desc">{post.data.description}</div>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
          <span class="post-date">{formatDate(post.data.date)}</span>
        </a>
      ))
    ) : (
      <div class="empty-card">Henüz not eklenmedi.</div>
    )}
  </div>
</BaseLayout>
