---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  summary: string;
  stack: string[];
  link?: string;
}

const projects: Project[] = [];
---

<BaseLayout title="Projeler | Metehan Beyaz" description="Projeler.">
  <div class="page-head">
    <div>
      <h1>Projeler</h1>
      <p class="lead">Üzerinde çalıştığım projeler.</p>
    </div>
  </div>

  <div class="stack">
    {projects.length > 0 ? (
      projects.map((p) => (
        <div class="card">
          <div class="section-head">
            <h3>{p.name}</h3>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener" class="subtle-link">
                İncele ↗
              </a>
            )}
          </div>
          <p class="muted">{p.summary}</p>
          {p.stack.length > 0 && (
            <div class="tags">
              {p.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          )}
        </div>
      ))
    ) : (
      <div class="empty-card">Projeler yakında eklenecek.</div>
    )}
  </div>
</BaseLayout>
