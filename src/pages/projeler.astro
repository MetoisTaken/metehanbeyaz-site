---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  summary: string;
  stack: string[];
  link?: string;
}

const projects: Project[] = [];
---

<BaseLayout title="Projeler | Metehan Beyaz" description="Projeler.">
  <h1>Projeler</h1>

  <div class="stack" style="margin-top:1.5rem;">
    {projects.length > 0 ? (
      projects.map((p) => (
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem;">
            <h3>{p.name}</h3>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener" class="muted" style="font-size:0.84rem;">
                İncele ↗
              </a>
            )}
          </div>
          <p class="muted" style="margin:0.35rem 0 0;">{p.summary}</p>
          {p.stack.length > 0 && (
            <div class="tags">
              {p.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          )}
        </div>
      ))
    ) : (
      <div class="card muted">Projeler yakında eklenecek.</div>
    )}
  </div>
</BaseLayout>
