  </div>

  <section class="section" style="margin-top: 0;">
    <h2 class="section-title">Hakkımda</h2>
    <div class="empty-card">Yakında güncellenecek.</div>
  </section>

  <section class="section">
    <h2 class="section-title">Deneyim &amp; Eğitim</h2>
    <div class="empty-card">Yakında güncellenecek.</div>
  </section>

  <section class="section">
    <h2 class="section-title">İletişim</h2>
    <p class="muted">
      Web: <a href="https://metehanbeyaz.com">metehanbeyaz.com</a>
    </p>
